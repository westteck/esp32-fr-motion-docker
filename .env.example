# ESP32-CAM AI-SYNC CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your details

# WiFi Settings
WIFI_SSID=your_ssid
WIFI_PASS=your_password

# Network Settings
STATIC_IP=10.10.10.x
GATEWAY=10.10.10.1
SUBNET=255.255.255.0
DNS=10.10.10.10

# Server Settings
SERVER_IP=10.10.10.110
SERVER_PORT=8787
CAM_ID=cam1

# Rclone / Proton Settings
PROTON_DRIVE_REMOTE=proton:Tanricllc/esp32-cam-backups
