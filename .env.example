# ESP32-CAM AI-SYNC CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your details. `.env` is gitignored.
#
# This file is read by docker-compose and passed to the PHP and brain
# containers as environment variables.

# ── Auth tokens (REQUIRED) ──────────────────────────
# Generate each with: openssl rand -hex 32
#
# CAM_TOKEN   - shared with the ESP32 firmware (esp32/secrets.h). Authorises
#               frame uploads and command/settings polling.
# ADMIN_TOKEN - required for the dashboard and all management actions
#               (face database, camera controls, reboot, manual sync).
CAM_TOKEN=
ADMIN_TOKEN=

# ── Host paths ──────────────────────────────────────
# Where the stack stores its data on the host.
DATA_DIR=./data

# ── Web ─────────────────────────────────────────────
HTTP_PORT=8787

# ── Retention ───────────────────────────────────────
# Motion frames are pruned once either limit is exceeded, per camera.
MAX_EVENTS_PER_CAM=500
MAX_EVENT_AGE_DAYS=14

# ── Rclone / Proton ─────────────────────────────────
# Remote name must match the section header in rclone.conf
RCLONE_REMOTE=proton:esp32-cam-backups
SYNC_INTERVAL_SEC=900
# Only upload files modified within this window (keeps sync cheap).
SYNC_MAX_AGE=24h

# ── Face recognition ────────────────────────────────
# Lower = stricter matching. 0.6 is the dlib default; 0.5 is safer.
FACE_TOLERANCE=0.5
