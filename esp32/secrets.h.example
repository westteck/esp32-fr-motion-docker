/*
  Copy this file to `secrets.h` and fill in your own values.
  `secrets.h` is gitignored and must NEVER be committed.
*/
#pragma once

// ── WiFi ────────────────────────────────────────────
#define WIFI_SSID "your_ssid"
#define WIFI_PASS "your_password"

// ── Server ──────────────────────────────────────────
#define SERVER_IP   "10.10.10.110"
#define SERVER_PORT 8787

// Shared secret; must match CAM_TOKEN in the server's .env file.
// Generate with: openssl rand -hex 32
#define CAM_TOKEN "replace_me_with_a_long_random_token"

// ── Per-device identity ─────────────────────────────
// Change this for each camera you flash: cam1, cam2, cam3 ...
#define CAM_ID "cam1"

// Static IP. Set USE_STATIC_IP to 0 to use DHCP instead.
#define USE_STATIC_IP 1
#define STATIC_IP_OCTETS 10, 10, 10, 2
#define GATEWAY_OCTETS   10, 10, 10, 1
#define SUBNET_OCTETS    255, 255, 255, 0
#define DNS_OCTETS       10, 10, 10, 1
